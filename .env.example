# =============================================================================
# Environment variables read by the app via getenv() (see common/config and
# environments/*/common/config/main-local.php).
#
# Copy to `.env` and fill in real values. NOTE: the app does not auto-load a
# .env file — these must be present in the actual process environment. Provide
# them via docker-compose `environment:` locally, or via the hosting panel /
# shell export / FPM pool config in production. This file is documentation +
# a template only.
# =============================================================================

# --- Database -----------------------------------------------------------------
DB_HOST=localhost
DB_NAME=yii2advanced
DB_USER=yii2advanced
DB_PASSWORD=

# --- Redis (production cache) -------------------------------------------------
# Only used by the prod environment (dev uses DummyCache, so Redis is not
# needed locally). See deploy/redis.conf.example for the server-side config.
#
# Prefer the unix socket on MyDevil; leave REDIS_SOCKET empty to fall back to
# TCP via REDIS_HOST/REDIS_PORT.
REDIS_SOCKET=/usr/home/LOGIN/domains/DOMENA/redis.sock
REDIS_HOST=localhost
REDIS_PORT=6379
# Must match `requirepass` in redis.conf — required on shared hosting.
REDIS_PASSWORD=
REDIS_DB=0
